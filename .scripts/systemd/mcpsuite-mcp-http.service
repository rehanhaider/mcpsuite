[Unit]
Description=mcpsuite MCP HTTP server (agents connect via Bearer API key)
After=network-online.target
# Stop retrying after 5 failed starts within 60 s: the unit then shows as
# "failed" instead of crash-looping unnoticed (a Node ABI mismatch once
# looped 24k+ times). Recover with `mise exec -- make deploy`, which clears
# the failed state (`systemctl --user reset-failed`) before restarting.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@REPO@/.scripts/mcp-http.sh
Restart=on-failure
RestartSec=3
Environment=MCP_PORT=8765
# Binds 127.0.0.1 only. Every request must send `Authorization: Bearer <key>`
# with an API key created in Admin -> Agents.

[Install]
WantedBy=default.target
