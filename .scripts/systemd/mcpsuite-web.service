[Unit]
Description=mcpsuite web app (TanStack Start production server, browser access via WSL localhost)
After=network-online.target
# Stop retrying after 5 failed starts within 60 s: the unit then shows as
# "failed" instead of crash-looping unnoticed (a Node ABI mismatch once
# looped 24k+ times). Recover with `mise exec -- make deploy`, which clears
# the failed state (`systemctl --user reset-failed`) before restarting.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@REPO@/.scripts/web.sh
Restart=on-failure
RestartSec=3
# Port is fixed to 2222 in apps/web `start` (srvx --port 2222).

[Install]
WantedBy=default.target
