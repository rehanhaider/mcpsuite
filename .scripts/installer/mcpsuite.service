# mcpsuite.service — MCP Suite CRM as a machine-wide systemd service.
# Installed to /etc/systemd/system/mcpsuite.service by install.sh.
# One process serves the web UI, POST /mcp, and GET /healthz on WEB_PORT.
# Config lives in /etc/mcpsuite/mcpsuite.env; data in /var/lib/mcpsuite; code under
# /opt/mcpsuite/releases/<version> behind the /opt/mcpsuite/current symlink.
[Unit]
Description=MCP Suite CRM (mcpsuite) — web UI + MCP server
Documentation=https://github.com/rehanhaider/mcpsuite
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mcpsuite
Group=mcpsuite
EnvironmentFile=/etc/mcpsuite/mcpsuite.env
Environment=HOME=/var/lib/mcpsuite
ExecStart=/opt/mcpsuite/current/bin/mcpsuite-run
WorkingDirectory=/opt/mcpsuite/current
Restart=on-failure
RestartSec=3

# Hardening: the service only ever writes its SQLite data under /var/lib/mcpsuite.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mcpsuite
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
